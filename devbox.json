{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": [
    "git@latest",
    "lastpass-cli",
    "ruby@3.4.4",
    "bash@latest",
    "rustup@latest",
    "openssl",
    "path:flakes/solr#default",
    "postgresql@latest",
    "redis@latest"
  ],
  "shell": {
    "init_hook": [
      "cargo fetch",
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "setup": [
        "test -f \"$PGDATA/PG_VERSION\" || initdb",
        "if [ $(bundle config cat | grep -c 'You have not configured') -gt 0 ]; then bin/setup; fi",
        "bundle install",
        "bundle exec rake compile"
      ],
      "test": [
        "devbox run setup",
        "RAILS_ENV=test bundle exec rake db:migrate",
        "cargo test",
        "bundle exec rspec"
      ]
    }
  }
}
